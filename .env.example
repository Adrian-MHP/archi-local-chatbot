# Azure OpenAI / Foundry model endpoint
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-5-mini

# Optional fallback deployment/model when primary is rate limited (429)
AZURE_OPENAI_FALLBACK_MODEL=

# Optional: use a stronger/different deployment specifically for document extraction
# (business-process-upload / requirements-upload) and the Architecture Assessment wizard's
# per-process reasoning (Soll proposal, Mapping & Gap Analysis). This work is reasoning-heavy
# and runs far less often than chat, so a higher-quality model here (e.g. a "pro"-tier
# deployment) is usually worth the extra cost. Falls back to AZURE_OPENAI_MODEL if left blank.
AZURE_OPENAI_EXTRACTION_MODEL=

# Optional: use an even stronger deployment specifically for the assessment's final Business
# Summary step (step 5) -- the one synthesis pass that reads across the whole assessment and
# produces the steerco-facing verdict, so it's worth the strongest model available even if
# AZURE_OPENAI_EXTRACTION_MODEL is a lighter tier. Falls back to AZURE_OPENAI_EXTRACTION_MODEL,
# then AZURE_OPENAI_MODEL, if left blank.
AZURE_OPENAI_SUMMARY_MODEL=

# Archi MCP endpoint
# For Docker on Windows/WSL with Archi on host, host.docker.internal is usually correct.
MCP_SERVER_URL=http://host.docker.internal:18090/mcp

# Optional if bearer auth enabled in Archi MCP preferences
MCP_BEARER_TOKEN=

# Optional Host header override. Archi MCP v1.7+ rejects requests whose Host is not loopback
# (403 "Origin/Host not allowed"), which is what happens when Docker reaches it via
# host.docker.internal. Set to the loopback address Archi is bound to.
MCP_HOST_HEADER=127.0.0.1:18090

# App runtime tuning
REQUEST_TIMEOUT_SECONDS=90
MODEL_TEMPERATURE=0.2
MAX_MODEL_RETRIES=3
MODEL_RETRY_BACKOFF_SECONDS=1.5
MAX_TOOL_ROUNDTRIPS=8
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_TEXT_CHARS=80000
MAX_ACTION_STEPS=60
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=*

# Optional system prompt override
SYSTEM_PROMPT=You are an ArchiMate assistant. Use MCP tools for model facts and do not invent IDs or relationships.
